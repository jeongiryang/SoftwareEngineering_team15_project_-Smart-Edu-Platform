@startuml SmartEduPlatformClassDiagram
title Smart Edu Platform - Class Diagram
scale 0.85

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide circle

package "User Domain" {
  class User {
    - userId: Long
    - email: String
    - passwordHash: String
    - name: String
    - userType: UserType
    - status: AccountStatus
    - createdAt: DateTime
    + signUp(email, password, name): void
    + login(email, password): AuthSession
    + updatePassword(oldPassword, newPassword): void
    + deactivate(): void
  }

  class UserProfile {
    - profileId: Long
    - learningGoal: String
    - profileImageUrl: String
    - targetExam: String
    - preferredSubject: String
    + updateGoal(goal): void
    + updateProfileImage(imageUrl): void
  }

  class AuthSession {
    - sessionId: String
    - accessToken: String
    - refreshToken: String
    - expiredAt: DateTime
    + isExpired(): Boolean
    + revoke(): void
  }

  class AccessibilitySetting {
    - settingId: Long
    - largeTextEnabled: Boolean
    - highContrastEnabled: Boolean
    - fontScale: Float
    - themeName: String
    + enableLargeText(): void
    + enableHighContrast(): void
    + updateFontScale(scale): void
  }
}

package "Schedule Domain" {
  class StudySchedule {
    - scheduleId: Long
    - title: String
    - subject: String
    - startAt: DateTime
    - endAt: DateTime
    - priority: Priority
    - repeatRule: String
    - memo: String
    + updateSchedule(title, startAt, endAt): void
    + cancel(): void
    + isDeadlineNear(now): Boolean
  }

  class StudyTask {
    - taskId: Long
    - title: String
    - status: TaskStatus
    - dueDate: Date
    - priority: Priority
    - memo: String
    + moveTo(status): void
    + complete(): void
    + updatePriority(priority): void
  }

  class Notification {
    - notificationId: Long
    - type: NotificationType
    - message: String
    - scheduledAt: DateTime
    - sentAt: DateTime
    - read: Boolean
    + send(): void
    + markAsRead(): void
  }

  class ExternalCalendarLink {
    - linkId: Long
    - provider: CalendarProvider
    - externalAccountId: String
    - syncEnabled: Boolean
    + syncSchedule(schedule): void
    + disableSync(): void
  }
}

package "Learning Domain" {
  class StudyNote {
    - noteId: Long
    - title: String
    - content: Text
    - subject: String
    - tags: String[]
    - createdAt: DateTime
    - updatedAt: DateTime
    + updateContent(content): void
    + addTag(tag): void
    + summarize(): Summary
  }

  class Quiz {
    - quizId: Long
    - title: String
    - subject: String
    - difficulty: Difficulty
    - createdAt: DateTime
    + addQuestion(question): void
    + grade(answers): QuizResult
  }

  class QuizQuestion {
    - questionId: Long
    - content: Text
    - choices: String[]
    - answer: String
    - explanation: Text
    + checkAnswer(userAnswer): Boolean
  }

  class WrongAnswerNote {
    - wrongAnswerNoteId: Long
    - problemContent: Text
    - userAnswer: Text
    - correctAnswer: Text
    - explanation: Text
    - weaknessType: String
    - createdAt: DateTime
    + updateExplanation(explanation): void
    + markReviewed(): void
  }

  class ReviewReminder {
    - reminderId: Long
    - reviewAt: DateTime
    - intervalDays: Integer
    - completed: Boolean
    + scheduleNext(): void
    + complete(): void
  }
}

package "AI Learning Domain" {
  class AIQuestion {
    - questionId: Long
    - prompt: Text
    - answer: Text
    - subject: String
    - createdAt: DateTime
    + saveAnswer(answer): void
  }

  class AIRecommendation {
    - recommendationId: Long
    - subject: String
    - weaknessType: String
    - reason: Text
    - priority: Integer
    + updatePriority(priority): void
  }

  class AIService {
    + answerQuestion(prompt, context): AIQuestion
    + generateWrongAnswerNote(problem, userAnswer): WrongAnswerNote
    + recommendWeakness(user): AIRecommendation[]
    + generateQuiz(note, difficulty, count): Quiz
    + summarizeText(text): Summary
  }

  class Summary {
    - summaryId: Long
    - sourceType: String
    - sourceId: Long
    - content: Text
    - keywords: String[]
  }
}

package "Focus and Analytics Domain" {
  class FocusSession {
    - sessionId: Long
    - subject: String
    - startedAt: DateTime
    - endedAt: DateTime
    - durationMinutes: Integer
    - memo: String
    + start(): void
    + stop(): void
    + calculateDuration(): Integer
  }

  class AppBlockRule {
    - ruleId: Long
    - appName: String
    - startedAt: DateTime
    - endedAt: DateTime
    - exceptionApp: String
    - enabled: Boolean
    + enable(): void
    + disable(): void
    + isActive(now): Boolean
  }

  class StudyStatistics {
    - statisticsId: Long
    - periodStart: Date
    - periodEnd: Date
    - totalStudyMinutes: Integer
    - completionRate: Float
    + calculateTotalTime(records): Integer
    + calculateCompletionRate(tasks): Float
    + createHeatmap(records): Heatmap
  }

  class Heatmap {
    - heatmapId: Long
    - startDate: Date
    - endDate: Date
    - dailyMinutes: Map<Date, Integer>
    + getDailyValue(date): Integer
  }
}

package "Social and Community Domain" {
  class StudyGroup {
    - groupId: Long
    - name: String
    - description: String
    - createdAt: DateTime
    + addMember(user): void
    + removeMember(user): void
  }

  class StudyChallenge {
    - challengeId: Long
    - title: String
    - goalMinutes: Integer
    - startDate: Date
    - endDate: Date
    - status: ChallengeStatus
    + join(user): void
    + updateProgress(user, minutes): void
    + close(): void
  }

  class Ranking {
    - rankingId: Long
    - periodStart: Date
    - periodEnd: Date
    - rankingType: RankingType
    + calculate(group): RankingEntry[]
  }

  class RankingEntry {
    - rank: Integer
    - studyMinutes: Integer
    - userName: String
  }

  class BoardPost {
    - postId: Long
    - category: PostCategory
    - title: String
    - content: Text
    - createdAt: DateTime
    - reported: Boolean
    + update(title, content): void
    + report(reason): void
  }

  class Comment {
    - commentId: Long
    - content: Text
    - createdAt: DateTime
    - reported: Boolean
    + update(content): void
    + report(reason): void
  }

  class Admin {
    - adminId: Long
    - name: String
    + hidePost(post): void
    + deleteComment(comment): void
    + reviewReport(post): void
  }
}

package "Reward Domain" {
  class RewardAccount {
    - rewardAccountId: Long
    - pointBalance: Integer
    + addPoint(point): void
    + usePoint(point): void
  }

  class Badge {
    - badgeId: Long
    - name: String
    - description: String
    - condition: String
    + isAchievedBy(user): Boolean
  }

  class UserBadge {
    - userBadgeId: Long
    - acquiredAt: DateTime
  }
}

enum UserType {
  ELEMENTARY
  MIDDLE
  HIGH
  UNIVERSITY
  EXAM_PREP
  WORKER
  SENIOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  DEADLINE
  REVIEW
  CHALLENGE
  FRIEND_ACTIVITY
}

enum CalendarProvider {
  GOOGLE
  APPLE
  OUTLOOK
}

enum Difficulty {
  EASY
  NORMAL
  HARD
}

enum ChallengeStatus {
  READY
  IN_PROGRESS
  CLOSED
}

enum RankingType {
  WEEKLY
  MONTHLY
}

enum PostCategory {
  QUESTION
  FREE
  STUDY_PROOF
}

User "1" *-- "1" UserProfile
User "1" *-- "0..*" AuthSession
User "1" *-- "1" AccessibilitySetting
User "1" *-- "0..*" StudySchedule
User "1" *-- "0..*" StudyTask
User "1" *-- "0..*" StudyNote
User "1" *-- "0..*" WrongAnswerNote
User "1" *-- "0..*" AIQuestion
User "1" *-- "0..*" AIRecommendation
User "1" *-- "0..*" FocusSession
User "1" *-- "0..*" AppBlockRule
User "1" *-- "1" RewardAccount

StudySchedule "1" o-- "0..*" Notification
StudySchedule "0..*" -- "0..1" ExternalCalendarLink
StudyTask "0..*" -- "0..1" StudySchedule
StudyTask "1" o-- "0..*" Notification

StudyNote "1" o-- "0..*" Quiz
StudyNote "1" o-- "0..*" Summary
Quiz "1" *-- "1..*" QuizQuestion
WrongAnswerNote "1" o-- "0..*" ReviewReminder

AIService ..> AIQuestion
AIService ..> WrongAnswerNote
AIService ..> AIRecommendation
AIService ..> Quiz
AIService ..> Summary

FocusSession "0..*" -- "0..1" StudyTask
StudyStatistics ..> FocusSession
StudyStatistics ..> StudyTask
StudyStatistics ..> Heatmap

StudyGroup "1" o-- "0..*" User
StudyGroup "1" o-- "0..*" StudyChallenge
StudyGroup "1" o-- "0..*" Ranking
Ranking "1" *-- "1..*" RankingEntry
RankingEntry "0..*" --> "1" User

User "1" -- "0..*" BoardPost
BoardPost "1" *-- "0..*" Comment
User "1" -- "0..*" Comment
Admin ..> BoardPost
Admin ..> Comment

RewardAccount "1" o-- "0..*" UserBadge
UserBadge "0..*" --> "1" Badge

User --> UserType
User --> AccountStatus
StudyTask --> TaskStatus
StudyTask --> Priority
StudySchedule --> Priority
Notification --> NotificationType
ExternalCalendarLink --> CalendarProvider
Quiz --> Difficulty
StudyChallenge --> ChallengeStatus
Ranking --> RankingType
BoardPost --> PostCategory

@enduml
