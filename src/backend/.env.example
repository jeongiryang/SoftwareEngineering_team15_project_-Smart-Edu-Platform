# Local PostgreSQL: DATABASE_URL and DIRECT_URL can use the same local connection string.
# Neon: use a pooled connection string for DATABASE_URL and a direct connection string for DIRECT_URL.
# Keep real .env values only in each local environment and never commit them.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_edu_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smart_edu_platform?schema=public"
JWT_SECRET="local-test-secret"
PORT=4000
CORS_ORIGIN="http://localhost:8081"
AI_API_KEY=""
